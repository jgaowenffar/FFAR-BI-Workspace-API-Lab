# API testing without Supabase: set these three variables in Vercel, then redeploy.
OPENAI_API_KEY=
LIVE_API_ENABLED=false
# Choose a random secret of at least 24 characters (32+ recommended).
# Enter this same value in the lab's access-key field. It is NOT your OpenAI key.
LAB_ACCESS_TOKEN=
# Optional, per-instance allowance without Supabase; not a global billing cap.
LAB_HOURLY_LIVE_CALLS=30

# Optional: enable shared cloud records once Supabase is set up.
# Leave ALL of these blank for API-only testing.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
LAB_WORKSPACE_ID=
# Optional extra API allowlist. Supabase membership remains mandatory.
LAB_ALLOWED_USER_IDS=

# Local hosted-storage smoke test only; not required in Vercel.
LAB_TEST_ACCESS_TOKEN_A=
LAB_TEST_ACCESS_TOKEN_B=
LAB_TEST_ACCESS_TOKEN_OUTSIDER=
